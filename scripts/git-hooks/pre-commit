#!/usr/bin/env bash
# minicoding-rs pre-commit hook
# 与 .pre-commit-config.yaml 内容一致，供无 pre-commit 工具的环境使用。
# 安装：cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 门禁：AGENTS.md §6.3（fmt/clippy/test/audit/deny/coverage）
set -euo pipefail

# pre-commit 阶段（每次提交，快速门禁）
echo "[pre-commit] cargo fmt --check ..."
cargo fmt --all -- --check

echo "[pre-commit] cargo clippy (deny warnings) ..."
# 排除 minicoding-desktop：desktop feature 需 Tauri 系统库（webkit2gtk/glib）
cargo clippy --workspace --exclude minicoding-desktop --all-targets --all-features -- -D warnings

echo "[pre-commit] cargo deny check ..."
# advisories 需要网络 fetch advisory-db。
# MINICODING_OFFLINE=1 强制离线；否则先在线，网络失败自动降级离线（advisory-db 可能过期）。
if [ "${MINICODING_OFFLINE:-0}" = "1" ]; then
  cargo deny --offline check advisories licenses bans sources
else
  deny_err=$(mktemp)
  if cargo deny check advisories licenses bans sources 2>"$deny_err"; then
    :
  elif grep -qE "failed to fetch advisory database|Could not connect|TLS connection" "$deny_err"; then
    echo "[pre-commit] 网络不可用，降级到离线模式（advisory-db 可能过期）" >&2
    cargo deny --offline check advisories licenses bans sources
  else
    cat "$deny_err" >&2
    rm -f "$deny_err"
    exit 1
  fi
  rm -f "$deny_err"
fi

echo "[pre-commit] trailing whitespace / EOF newline / secrets ..."
rc=0
# 排除 ts-rs 自动生成的文件（trailing whitespace 是库输出特性，见 gen-types 脚本后处理）
EXCLUDE_PATTERN='crates/minicoding-web/src/api/generated/'
while IFS= read -r f; do
  if [ -f "$f" ] && [ -s "$f" ]; then
    # 跳过自动生成的文件
    case "$f" in
      *"$EXCLUDE_PATTERN"*) continue ;;
    esac
    # 跳过二进制文件（图片/字体/压缩包等，grep -I 检测）
    grep -qI '' "$f" 2>/dev/null || continue
    # trailing whitespace
    if grep -nE '[[:space:]]+$' "$f" >/dev/null 2>&1; then
      echo "  trailing whitespace: $f"
      rc=1
    fi
    # EOF newline
    if [ "$(tail -c1 "$f")" != "" ]; then
      echo "  missing EOF newline: $f"
      rc=1
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=AM)

# 敏感文件检查（AGENTS.md §6.4）
if git diff --cached --name-only | grep -Eq '\.env$|\.env\.local$|credentials\.json$|\.pem$|\.key$'; then
  echo "ERROR: 敏感文件被暂存（见 AGENTS.md §6.4）"
  git diff --cached --name-only | grep -E '\.env$|\.env\.local$|credentials\.json$|\.pem$|\.key$'
  rc=1
fi

# pre-push 阶段（推送前，完整门禁——与 CI 一致）
# 仅在推送时运行（环境变量 MINICODING_PRE_PUSH=1 由 pre-push hook 设置，或手动运行）
if [ "${MINICODING_PRE_PUSH:-0}" = "1" ]; then
  echo "[pre-push] cargo audit ..."
  # `cargo audit` 默认：vulnerabilities 失败、unmaintained/yanked/notices 仅警告
  #（不用 `--deny vulnerabilities`——该参数无效，vulnerabilities 默认就 deny）
  cargo audit

  echo "[pre-push] cargo test --workspace ..."
  # 排除 minicoding-desktop：desktop feature 需 Tauri 系统库（webkit2gtk/glib）
  cargo test --workspace --exclude minicoding-desktop --all-features

  echo "[pre-push] cargo llvm-cov (≥80%) ..."
  # 排除前端层（tui/cli/server/desktop），库 crate 覆盖率目标 ≥80%
  cargo llvm-cov --workspace --exclude minicoding-desktop --all-features \
    --exclude minicoding-tui --exclude minicoding-cli --exclude minicoding-server \
    --fail-under-lines 80
fi

exit $rc
