{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认权限：core + shell sidecar + log + global-shortcut",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/minicoding-server-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/minicoding-server-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-open",
    "shell:allow-kill",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
