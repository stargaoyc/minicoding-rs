{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minicoding",
  "version": "0.3.5",
  "identifier": "com.minicoding.desktop",
  "build": {
    "frontendDist": "../minicoding-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "minicoding",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/minicoding-server-sidecar"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
