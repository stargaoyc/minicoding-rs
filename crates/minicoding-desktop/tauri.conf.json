{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minicoding",
  "version": "0.2.0",
  "identifier": "com.minicoding.desktop",
  "build": {
    "frontendDist": "../minicoding-web/dist",
    "beforeDevCommand": "cd ../minicoding-web && npm run dev",
    "beforeBuildCommand": "cd ../minicoding-web && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "minicoding",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/minicoding-server"
    ]
  }
}
