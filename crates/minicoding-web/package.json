{
  "name": "minicoding-web",
  "version": "1.0.0",
  "private": true,
  "description": "minicoding-rs Web 前端（React 19 + Vite + Tailwind v4，M9）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen-types": "cargo test -p minicoding-protocol --features ts -- --nocapture 2>&1 | tail -5 && cargo test -p minicoding-core --features ts -- --nocapture 2>&1 | tail -3 && cargo test -p minicoding-server --features ts -- --nocapture 2>&1 | tail -3 && node scripts/gen-types-post.mjs && pnpm exec oxfmt src/api/generated/ 2>&1 | tail -1",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:record": "SNAPSHOT_MODE=record vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.105.3",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
