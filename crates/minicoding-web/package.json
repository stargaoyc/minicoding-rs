{
  "name": "minicoding-web",
  "version": "0.2.30",
  "private": true,
  "description": "minicoding-rs Web 前端（React 19 + Vite + Tailwind v4，M9）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen-types": "cargo test -p minicoding-protocol --features ts -- --nocapture 2>&1 | tail -5 && find src/api/generated -name '*.ts' -exec sed -i 's/[[:space:]]*$//' {} +",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:record": "SNAPSHOT_MODE=record vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slot": "1.3.1",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
