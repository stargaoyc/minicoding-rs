# 可观测性基础设施环境变量（复制为 .env 后按需修改）
# docker compose 会自动读取同目录 .env 文件

# 镜像版本（升级可观测性组件时统一在此调整）
# OTEL_COLLECTOR_IMG=otel/opentelemetry-collector-contrib:0.119.0
# JAEGER_IMG=jaegertracing/jaeger:2.9.0
# PROMETHEUS_IMG=prom/prometheus:v2.55.1
# GRAFANA_IMG=grafana/grafana:11.5.2

# 宿主端口映射（默认仅绑定 127.0.0.1）
# OTLP_HTTP_PORT=4318
# OTLP_GRPC_PORT=4317
# JAEGER_UI_PORT=16686
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Prometheus 数据保留时长
# PROMETHEUS_RETENTION=7d

# Grafana 管理员密码（仅本机可访问，生产部署务必修改）
# GRAFANA_ADMIN_PASSWORD=admin
